<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/_230sdp"
    android:layout_height="wrap_content"
    android:background="@drawable/ic_dialog_bg"
    android:orientation="vertical"
    android:padding="@dimen/_16sdp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_bold"
        android:gravity="center"
        android:text="ตั้งค่าจำกัดเฟรมเรต (FPS Limit)"
        android:textColor="@color/white"
        android:textSize="@dimen/_12sdp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/_2sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:layout_marginBottom="@dimen/_12sdp"
        android:background="#FFE5A93C" />

    <RadioGroup
        android:id="@+id/dialog_fps_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/fps_30"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_bold"
            android:paddingStart="@dimen/_6sdp"
            android:text="30 FPS (ประหยัดแบตเตอรี่)"
            android:textColor="@color/white"
            android:textSize="@dimen/_10sdp" />

        <RadioButton
            android:id="@+id/fps_60"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:fontFamily="@font/montserrat_bold"
            android:paddingStart="@dimen/_6sdp"
            android:text="60 FPS (มาตรฐาน ลื่นไหล)"
            android:textColor="@color/white"
            android:textSize="@dimen/_10sdp" />

        <RadioButton
            android:id="@+id/fps_90"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:fontFamily="@font/montserrat_bold"
            android:paddingStart="@dimen/_6sdp"
            android:text="90 FPS (ลื่นไหลสูง)"
            android:textColor="@color/white"
            android:textSize="@dimen/_10sdp" />

        <RadioButton
            android:id="@+id/fps_120"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:fontFamily="@font/montserrat_bold"
            android:paddingStart="@dimen/_6sdp"
            android:text="120 FPS (สูงสุด Refresh Rate สูง)"
            android:textColor="@color/white"
            android:textSize="@dimen/_10sdp" />
    </RadioGroup>

    <Button
        android:id="@+id/dialog_fps_btn_save"
        android:layout_width="@dimen/_90sdp"
        android:layout_height="@dimen/_30sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/_14sdp"
        android:background="@drawable/ic_buttoncolor"
        android:fontFamily="@font/montserrat_bold"
        android:text="บันทึก"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="@dimen/_10sdp" />

</LinearLayout>
