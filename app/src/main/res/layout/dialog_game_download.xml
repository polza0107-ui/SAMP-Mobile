<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/_340sdp"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_download_bg"
    android:orientation="vertical"
    android:paddingStart="@dimen/_18sdp"
    android:paddingTop="@dimen/_14sdp"
    android:paddingEnd="@dimen/_18sdp"
    android:paddingBottom="@dimen/_14sdp">

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:src="@drawable/logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dialog_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_bold"
                android:text="4KING ROLEPLAY • ติดตั้งข้อมูลตัวเกม (DATA)"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_12sdp" />

            <TextView
                android:id="@+id/dialog_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_regular"
                android:text="ดาวน์โหลดและแตกไฟล์ลงเครื่อง (/storage/emulated/0/GTA) อัตโนมัติ"
                android:textColor="#B0BEC5"
                android:textSize="@dimen/_8sdp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Accent Divider Line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/_2sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:layout_marginBottom="@dimen/_10sdp"
        android:background="#60FB8500" />

    <!-- Status & Details Info Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/attach_black_round_rect"
        android:orientation="vertical"
        android:paddingStart="@dimen/_10sdp"
        android:paddingTop="@dimen/_8sdp"
        android:paddingEnd="@dimen/_10sdp"
        android:paddingBottom="@dimen/_8sdp">

        <TextView
            android:id="@+id/tv_status_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_bold"
            android:text="พร้อมดาวน์โหลดข้อมูลตัวเกม"
            android:textColor="#FFB703"
            android:textSize="@dimen/_10sdp" />

        <TextView
            android:id="@+id/tv_status_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:fontFamily="@font/montserrat_regular"
            android:text="ไฟล์: GTA.zip | จุดแตกไฟล์: /storage/emulated/0/"
            android:textColor="#90A4AE"
            android:textSize="@dimen/_8sdp" />

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progress_bar_download"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_game_download" />

        <!-- Percent & Speed Counter -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_progress_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_bold"
                android:text="0%"
                android:textColor="#00E5FF"
                android:textSize="@dimen/_10sdp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_progress_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_regular"
                android:text="0.0 MB / -- MB (0 KB/s)"
                android:textColor="#ECEFF1"
                android:textSize="@dimen/_8sdp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12sdp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_download_cancel"
            android:layout_width="@dimen/_80sdp"
            android:layout_height="@dimen/_28sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:background="@drawable/button_br_red_unfilled"
            android:fontFamily="@font/montserrat_bold"
            android:text="ปิด"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_9sdp" />

        <Button
            android:id="@+id/btn_download_action"
            android:layout_width="@dimen/_125sdp"
            android:layout_height="@dimen/_28sdp"
            android:background="@drawable/ic_buttoncolor"
            android:fontFamily="@font/montserrat_bold"
            android:text="⚡ เริ่มดาวน์โหลด"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_9sdp" />
    </LinearLayout>

</LinearLayout>
