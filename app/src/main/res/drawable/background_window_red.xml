<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp"/>
            <gradient
                android:startColor="#EA101217"
                android:centerColor="#F0151821"
                android:endColor="#EA19151A"
                android:angle="135"/>
            <stroke
                android:width="1.5dp"
                android:color="#35E5A93C"/>
        </shape>
    </item>
</layer-list>
